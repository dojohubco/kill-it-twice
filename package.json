    "test:integration:m6": "npm run build:api && node scripts/m1.ts m6",
    "review:m6": "node scripts/review-m4.ts --m6",
    "operations": "node scripts/operations.ts",
    "build:ui": "ng build operator-ui",
    "ui:dev": "ng serve operator-ui",
