    "@nestjs/platform-express": "12.0.3",
    "@nestjs/swagger": "12.0.1",
    "amqplib": "2.0.1",
    "lossless-json": "4.3.1",
    "pg": "8.23.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2"
  },
  "devDependencies": {
    "@angular/build": "21.2.24",
    "@angular/cli": "21.2.24",
    "@angular/compiler-cli": "21.2.23",
    "@axe-core/playwright": "4.13.0",
